# syntax=docker/dockerfile:1.7
# ============================================================
# Backend Multi-Stage Dockerfile
# 3 target: builder (base), test (dengan devDeps), runtime (prod)
# ============================================================

# ---------- Stage 1: Builder ----------
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# ---------- Stage 2: Test (dipakai untuk `npm test`) ----------
FROM builder AS test
CMD ["npm", "test"]

# ---------- Stage 3: Runtime (production, non-root, ≤160MB) ----------
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder --chown=node:node /app/src ./src

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/healthz/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/server.js"]